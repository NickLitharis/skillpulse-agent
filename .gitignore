# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage*
htmlcov/
*.egg-info/
build/
dist/

# Env / secrets
.env
.env.*
!.env.example

# Local datasets, databases and scratch files
.tmp/
data/
*.sqlite
*.sqlite3
*.db
*.log

# Eval outputs
eval/results/*
!eval/results/.gitkeep
# The latest committed summary is the only result that ships (SPEC section 15).
!eval/results/baseline_synthetic.json
# The M4 agent fixture (fake-model) summary ships alongside the baseline; real-model
# results would need a provider credential and are not produced here.
!eval/results/agent_fixture_fake.json
# The canonical five-year-fixture fake-model contract run (model=fake, synthetic only,
# not_real_acceptance). Real-model S3/S4 results are never produced in CI.
!eval/results/agent_fixture_synthetic.json
# The one real-provider run, produced locally on a paid key: the model is named inside the
# file and the fixture carries no Hacker News text.
!eval/results/llm_synthetic.json
!eval/results/agent_fixture_real.json

# OS / editor
.DS_Store
.idea/
.vscode/

# Local infrastructure state
infra/.terraform/
infra/*.tfstate
infra/*.tfstate.*
infra/*.tfplan
infra/crash.log
infra/.kubeconfig
