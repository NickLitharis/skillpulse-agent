{
  "tools": [
    {
      "name": "search_jobs",
      "description": "Structured post rows for filters; max 20; never post text.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "extractor": {
            "default": "baseline",
            "enum": [
              "baseline",
              "llm"
            ],
            "title": "Extractor",
            "type": "string"
          },
          "role_family": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Role Family"
          },
          "remote": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Remote"
          },
          "months": {
            "anyOf": [
              {
                "maximum": 240,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Months"
          },
          "month_from": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Month From"
          },
          "month_to": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Month To"
          },
          "skill_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Skill Id"
          },
          "limit": {
            "default": 20,
            "maximum": 20,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "search_jobsArguments"
      },
      "outputSchema": {
        "type": "object",
        "additionalProperties": true,
        "title": "search_jobsDictOutput"
      }
    },
