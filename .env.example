# Variable names only -- never commit real values.
# Copy to .env and fill in for local runs.

# Postgres (docker-compose maps this to localhost:5433)
SKILLPULSE_DATABASE_URL=postgresql+psycopg2://skillpulse:skillpulse@localhost:5433/skillpulse

# Hacker News API (official, no key)
SKILLPULSE_HN_BASE_URL=https://hacker-news.firebaseio.com/v0
SKILLPULSE_HN_MAX_REQUESTS_PER_SECOND=10
SKILLPULSE_HN_MAX_RETRIES=5
SKILLPULSE_HN_TIMEOUT_SECONDS=20

# Live HN access is gated: authorization to read and store HN post text is unresolved
# (docs/terms.md). Leave false; set true only once an explicit authorization decision
# for this use has been recorded there.
SKILLPULSE_HN_LIVE_FETCH_ENABLED=false

# Celery workers (docker-compose maps Redis to localhost:6379)
SKILLPULSE_REDIS_URL=redis://localhost:6379/0
SKILLPULSE_CELERY_TASK_MAX_RETRIES=3
SKILLPULSE_CELERY_UPDATE_INTERVAL_SECONDS=21600
SKILLPULSE_THREAD_LOCK_TTL_SECONDS=900

# Logging
SKILLPULSE_LOG_LEVEL=INFO
