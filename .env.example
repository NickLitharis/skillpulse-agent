# Variable names only -- never commit real values.
# Copy to .env and fill in for local runs.

# Postgres (docker-compose maps this to localhost:5433)
SKILLPULSE_DATABASE_URL=postgresql+psycopg2://skillpulse:skillpulse@localhost:5433/skillpulse

# Hacker News API (official, no key)
SKILLPULSE_HN_BASE_URL=https://hacker-news.firebaseio.com/v0
SKILLPULSE_HN_MAX_REQUESTS_PER_SECOND=10
SKILLPULSE_HN_MAX_RETRIES=5
SKILLPULSE_HN_TIMEOUT_SECONDS=20

# Live HN access is gated: authorization to read and store HN post text is unresolved
# (docs/terms.md). Leave false; set true only once an explicit authorization decision
# for this use has been recorded there.
SKILLPULSE_HN_LIVE_FETCH_ENABLED=false

# Celery workers (docker-compose maps Redis to localhost:6379)
SKILLPULSE_REDIS_URL=redis://localhost:6379/0
SKILLPULSE_CELERY_TASK_MAX_RETRIES=3
SKILLPULSE_CELERY_UPDATE_INTERVAL_SECONDS=21600
SKILLPULSE_THREAD_LOCK_TTL_SECONDS=900

# Logging
SKILLPULSE_LOG_LEVEL=INFO

# worker-skills extraction and nightly trend-view refresh
SKILLPULSE_SKILL_EXTRACT_INTERVAL_SECONDS=21600
SKILLPULSE_SKILL_EXTRACT_BATCH_SIZE=200
SKILLPULSE_SKILL_EXTRACT_MAX_PER_RUN=2000
SKILLPULSE_TREND_REFRESH_HOUR_UTC=2
SKILLPULSE_TREND_REFRESH_MINUTE_UTC=30

# M4 agent. Off by default; the agent never reads ambient credentials, only this key.
# A real provider call also requires the shared Redis budget above to be reachable.
SKILLPULSE_AGENT_LLM_ENABLED=false
SKILLPULSE_AGENT_LLM_BASE_URL=
SKILLPULSE_AGENT_LLM_MODEL=
SKILLPULSE_AGENT_LLM_API_KEY=
SKILLPULSE_AGENT_MAX_TOOL_CALLS=6
SKILLPULSE_AGENT_OVERALL_TIMEOUT_SECONDS=60
SKILLPULSE_AGENT_DAILY_TOKEN_BUDGET=2000000

# Read-only tool sessions: statement timeout and hard row cap.
SKILLPULSE_TOOL_STATEMENT_TIMEOUT_MS=5000
SKILLPULSE_TOOL_MAX_ROWS=200

# M5 MCP server. stdio is a local pipe. The streamable HTTP transport binds loopback
# only and keeps DNS-rebinding protection on; list values are JSON and "*:*"-style
# wildcards are accepted. Set SKILLPULSE_MCP_ALLOW_NON_LOOPBACK=true (and widen the
# lists) only behind a controlled network -- the server refuses a non-loopback bind
# otherwise.
SKILLPULSE_MCP_HOST=127.0.0.1
SKILLPULSE_MCP_PORT=8765
SKILLPULSE_MCP_PATH=/mcp
SKILLPULSE_MCP_ALLOWED_HOSTS=["127.0.0.1:*", "localhost:*", "[::1]:*"]
SKILLPULSE_MCP_ALLOWED_ORIGINS=["http://127.0.0.1:*", "http://localhost:*", "http://[::1]:*"]
SKILLPULSE_MCP_ALLOW_NON_LOOPBACK=false

# Optional metadata-only Langfuse OTLP/HTTP export for /v1/ask.
# No prompts, answers, CVs or tool arguments/results are exported.
# Local k3d bootstrap forces this off; enable it separately only after review.
SKILLPULSE_LANGFUSE_ENABLED=false
SKILLPULSE_LANGFUSE_BASE_URL=
SKILLPULSE_LANGFUSE_PUBLIC_KEY=
SKILLPULSE_LANGFUSE_SECRET_KEY=
